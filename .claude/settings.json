{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "component-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/implement/scripts/run-hooks.js\" review",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "component-reviewer|spec-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/review/scripts/review-hooks.js\" save",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(/opt/homebrew/bin/gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(/opt/homebrew/bin/gh pr review*)",
      "Bash(gh api *merge*)",
      "Bash(/opt/homebrew/bin/gh api *merge*)",
      "Bash(gh api *rulesets*)",
      "Bash(/opt/homebrew/bin/gh api *rulesets*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git -C * push*)"
    ]
  }
}
