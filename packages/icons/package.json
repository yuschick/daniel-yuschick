{
  "name": "@dy/icons",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "ISC AND MIT",
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/attributes": null,
    "./react/*": {
      "types": "./dist/react/icons/*.d.ts",
      "default": "./dist/react/icons/*.js"
    },
    "./svg/*": "./dist/svg/*",
    "./manifest.json": "./src/icons.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/generate.js && tsdown",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@dy/configs": "workspace:*",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "svgo": "4.1.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  }
}
