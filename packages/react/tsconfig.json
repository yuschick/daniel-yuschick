{
  "extends": "@dy/configs/typescript/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "strictNullChecks": true,
    "paths": {
      "@package-components/*": ["./src/components/*"],
      "@package-hooks/*": ["./src/hooks/*"],
      "@package-internal/*": ["./src/internal/*"],
      "@package-internal-hooks/*": ["./src/internal/hooks/*"],
      "@package-providers/*": ["./src/providers/*"],
      "@package-specs/*": ["./specs/*"],
      "@package-types/*": ["./src/types/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
